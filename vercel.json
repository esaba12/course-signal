{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "uiuc-course-signal"
      }
    }
  ],
  "services": {
    "uiuc-course-signal": {
      "root": ".",
      "buildCommand": "python3 build_vercel.py",
      "entrypoint": "api/index.py"
    }
  }
}
